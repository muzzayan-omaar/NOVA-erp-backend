generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  email    String?
  phone    String?
  country  String?
  currency String  @default("UGX")
  timezone String?
  logo     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[] // we keep Store for now (transition phase)
  users  User[]

  products  Product[]
  customers Customer[]

  sales     Sale[]
  suppliers Supplier[]

  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]

  @@map("company")
}

model Store {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @db.Uuid // NEW

  name     String
  location String?
  phone    String?

  isHeadOffice Boolean @default(false) // NEW

  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  customers          Customer[]
  products           Product[]
  sales              Sale[]
  users              User[]
  suppliers          Supplier[]
  inventoryMovements InventoryMovement[]
  activeUsers        User[]              @relation("ActiveStore")

  outgoingTransfers InventoryMovement[] @relation("TransferSource")

  incomingTransfers InventoryMovement[] @relation("TransferTarget")
  auditLogs         AuditLog[]

  @@map("store")
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @db.Uuid // NEW

  name         String
  email        String
  passwordHash String

  role Role? @default(CASHIER)

  storeId       String  @db.Uuid
  activeStoreId String? @db.Uuid

  isActive Boolean? @default(true)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  store       Store  @relation(fields: [storeId], references: [id])
  activeStore Store? @relation("ActiveStore", fields: [activeStoreId], references: [id])

  auditLogs      AuditLog[]
  inventoryMoves InventoryMovement[]
  sales          Sale[]

  @@unique([companyId, email])
  @@map("user")
}

model Product {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @db.Uuid
  storeId   String @db.Uuid

  name    String
  barcode String?
  sku     String

  buyingPrice  Float
  sellingPrice Float

  stockQuantity Float?  @default(0)
  unitType      String? @default("pcs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  saleItems      SaleItem[]
  inventoryMoves InventoryMovement[]

  isActive Boolean @default(true)

  @@unique([companyId, sku])
  @@map("product")
}

model Customer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @db.Uuid // NEW
  storeId   String @db.Uuid

  name  String
  phone String?
  email String?

  totalCredit Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@map("customer")
}

model Sale {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @db.Uuid // NEW
  storeId   String @db.Uuid

  userId String @db.Uuid

  totalAmount Float
  subtotal    Float?
  vatAmount   Float?
  discount    Float  @default(0)

  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)

  fiscalReceiptId String?
  qrCodeData      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  saleItems SaleItem[]

  receiptNumber String?
  invoiceNumber String?

  @@map("sale")
}

model SaleItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String @db.Uuid
  productId String @db.Uuid

  quantity  Float
  unitPrice Float
  subtotal  Float

  createdAt DateTime? @default(now()) @db.Timestamptz(6)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sale_item")
}

model InventoryMovement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @db.Uuid
  storeId   String @db.Uuid // or branchId later

  productId   String @db.Uuid
  createdById String @db.Uuid

  type     InventoryMovementType
  quantity Float
  reason   String?

  sourceStoreId String? @db.Uuid
  targetStoreId String? @db.Uuid

  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
  store     Store   @relation(fields: [storeId], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  sourceStore Store? @relation("TransferSource", fields: [sourceStoreId], references: [id])

  targetStore Store? @relation("TransferTarget", fields: [targetStoreId], references: [id])

  @@map("inventory_movement")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @db.Uuid

  action     String
  entityType String
  entityId   String

  metadata  Json?
  ipAddress String?

  companyId String  @db.Uuid
  storeId   String? @db.Uuid

  createdAt DateTime? @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  company Company @relation(fields: [companyId], references: [id])

  store Store? @relation(fields: [storeId], references: [id])

  @@map("audit_log")
}

model Supplier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @db.Uuid
  storeId   String? @db.Uuid

  name      String
  phone     String?
  email     String?
  address   String?
  totalOwed Float   @default(0)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  store   Store?  @relation(fields: [storeId], references: [id])

  @@map("supplier")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  CREDIT
  MIXED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOID
}

enum InventoryMovementType {
  IN
  OUT
  SALE
  ADJUSTMENT
}
