generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String?
  phone              String?
  country            String?
  currency           String              @default("UGX")
  timezone           String?
  logo               String?
  businessCode String? @unique
  termsAcceptedAt DateTime?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          AuditLog[]
  customers          Customer[]
  inventoryMovements InventoryMovement[]
  payrolls           Payroll[]
  products           Product[]
  sales              Sale[]
  stores             Store[]
  suppliers          Supplier[]
  users              User[]
  notifications      Notification[]
  customerPayments CustomerPayment[]
  expenses    Expense[]
  stockCounts StockCount[]
  supportThreads SupportThread[]

  subscription Subscription?
  payments     Payment[]
  bundles CompanyBundle[]
  purchaseOrders PurchaseOrder[]
  
  @@map("company")
}

model Store {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String              @db.Uuid
  name               String
  location           String?
  phone              String?
  isHeadOffice       Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime?           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?           @default(now()) @updatedAt @db.Timestamptz(6)
  auditLogs          AuditLog[]
  customers          Customer[]
  outgoingTransfers  InventoryMovement[] @relation("TransferSource")
  inventoryMovements InventoryMovement[]
  incomingTransfers  InventoryMovement[] @relation("TransferTarget")
  payrolls           Payroll[]
  products           Product[]
  sales              Sale[]
  company            Company             @relation(fields: [companyId], references: [id])
  suppliers          Supplier[]
  activeUsers        User[]              @relation("ActiveStore")
  users              User[]
  notifications      Notification[]
  expenses           Expense[]
  stockCounts        StockCount[]
  purchaseOrders PurchaseOrder[]
  customerPayments CustomerPayment[]

  @@map("store")
}

model User {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String              @db.Uuid
  name           String
  email          String
  passwordHash   String
  role           Role                @default(CASHIER)
  storeId        String              @db.Uuid
  activeStoreId  String?             @db.Uuid
  isActive       Boolean?            @default(true)
  createdAt      DateTime?           @default(now())
  updatedAt      DateTime?           @updatedAt
  auditLogs      AuditLog[]
  inventoryMoves InventoryMovement[]
  payrolls       Payroll[]
  sales          Sale[]
  notifications  Notification[]
  supportMessages SupportMessage[]
  purchaseOrders PurchaseOrder[]
  customerPayments CustomerPayment[]
  isPlatformAdmin   Boolean   @default(false)
  mustChangePassword Boolean @default(false)
  paymentsSubmitted Payment[] @relation("PaymentSubmittedBy")
  activeStore    Store?              @relation("ActiveStore", fields: [activeStoreId], references: [id])
  company        Company             @relation(fields: [companyId], references: [id])
  store          Store               @relation(fields: [storeId], references: [id])

  voidedSales     Sale[]    @relation("SaleVoidedBy")
  authorizedVoids Sale[]    @relation("SaleAuthorizedBy")
  expensesCreated Expense[] @relation("ExpenseCreatedBy")

  stockCountsCreated StockCount[] @relation("StockCountCreatedBy")
  
  @@unique([companyId, email])
  @@map("user")
}

model Product {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String              @db.Uuid
  storeId         String              @db.Uuid
  name            String
  barcode         String?
  sku             String
  buyingPrice     Float
  sellingPrice    Float
  stockQuantity   Float?              @default(0)
  unitType        String?             @default("pcs")
  linkedFamilyId String? @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  isActive        Boolean             @default(true)
  inventoryMoves  InventoryMovement[]
  company         Company             @relation(fields: [companyId], references: [id])
  store           Store               @relation(fields: [storeId], references: [id])
  saleItems       SaleItem[]
  stockCountItems StockCountItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([companyId, linkedFamilyId])
  @@unique([companyId, sku])
  @@map("product")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @db.Uuid
  storeId     String   @db.Uuid
  name        String
  phone       String?
  email       String?
  totalCredit Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])
  sales    Sale[]
  payments CustomerPayment[]
  creditLimit Float @default(0)
  @@map("customer")
}

model Sale {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @db.Uuid
  storeId         String        @db.Uuid
  userId          String        @db.Uuid
  totalAmount     Float
  subtotal        Float?
  vatAmount       Float?
  discount        Float         @default(0)
  paymentMethod   PaymentMethod
  status          SaleStatus    @default(COMPLETED)
  fiscalReceiptId String?
  qrCodeData      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  receiptNumber   String?
  invoiceNumber   String?
  requestedAt     DateTime?
  rejectionReason String?
  clientReferenceId String?
  clientCreatedAt   DateTime?
  
  company         Company       @relation(fields: [companyId], references: [id])
  store           Store         @relation(fields: [storeId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  saleItems       SaleItem[]
  payments SalePayment[]
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  voidedAt       DateTime?
  voidReason     String?
  voidedById     String?   @db.Uuid
  authorizedById String?   @db.Uuid

  voidedBy     User? @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  authorizedBy User? @relation("SaleAuthorizedBy", fields: [authorizedById], references: [id])
  @@unique([companyId, clientReferenceId])
  @@map("sale")
}

model SaleItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String    @db.Uuid
  productId String    @db.Uuid
  quantity  Float
  unitPrice Float
  subtotal  Float
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sale_item")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String                @db.Uuid
  storeId       String                @db.Uuid
  productId     String                @db.Uuid
  createdById   String                @db.Uuid
  type          InventoryMovementType
  quantity      Float
  reason        String?
  sourceStoreId String?               @db.Uuid
  targetStoreId String?               @db.Uuid
  createdAt     DateTime              @default(now())
  company       Company               @relation(fields: [companyId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  product       Product               @relation(fields: [productId], references: [id])
  sourceStore   Store?                @relation("TransferSource", fields: [sourceStoreId], references: [id])
  store         Store                 @relation(fields: [storeId], references: [id])
  targetStore   Store?                @relation("TransferTarget", fields: [targetStoreId], references: [id])

  @@map("inventory_movement")
}

model AuditLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  companyId  String    @db.Uuid
  storeId    String?   @db.Uuid
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  company    Company   @relation(fields: [companyId], references: [id])
  store      Store?    @relation(fields: [storeId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_log")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  storeId   String?  @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  totalOwed Float    @default(0)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  store     Store?   @relation(fields: [storeId], references: [id])
  purchaseOrders PurchaseOrder[]
  expenses Expense[]
  @@map("supplier")
}

model Payroll {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @db.Uuid
  storeId         String        @db.Uuid
  userId          String        @db.Uuid
  month           String
  basicSalary     Float
  allowances      Float         @default(0)
  bonus           Float         @default(0)
  grossSalary     Float
  nssfEmployee    Float         @default(0)
  nssfEmployer    Float         @default(0)
  payeTax         Float         @default(0)
  otherDeductions Float         @default(0)
  netPay          Float
  status          PayrollStatus @default(PENDING)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id])
  store           Store         @relation(fields: [storeId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@map("payroll")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @db.Uuid
  storeId     String   @db.Uuid
  category    String
  description String?
  amount      Float
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])
  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  createdBy User @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  expenseType ExpenseType @default(OPERATING)
  @@map("expense")
}

model StockCount {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String           @db.Uuid
  storeId     String           @db.Uuid
  createdById String           @db.Uuid
  status      StockCountStatus @default(OPEN)
  notes       String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  items       StockCountItem[]
  company     Company          @relation(fields: [companyId], references: [id])
  store       Store            @relation(fields: [storeId], references: [id])
  createdBy   User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])

  @@map("stock_count")
}

model StockCountItem {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockCountId    String     @db.Uuid
  productId       String     @db.Uuid
  systemQuantity  Float
  countedQuantity Float?
  variance        Float?
  stockCount      StockCount @relation(fields: [stockCountId], references: [id])
  product         Product    @relation(fields: [productId], references: [id])

  @@map("stock_count_item")
}

enum StockCountStatus {
  OPEN
  COMPLETED
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

enum Role {
  GENERAL_MANAGER
  BRANCH_MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  CREDIT
  MIXED
}

enum SaleStatus {
  COMPLETED
  PENDING_VOID
  PENDING_REFUND
  VOID
  REFUNDED
}

enum InventoryMovementType {
  IN
  OUT
  SALE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum NotificationType {
  LOW_STOCK
  LOGIN
  LOGOUT
  FAILED_LOGIN
  TARGET
  SALE
  INVENTORY
  SYSTEM
  APPROVAL_REQUEST
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Notification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String               @db.Uuid
  storeId   String?              @db.Uuid
  userId    String?              @db.Uuid
  title     String
  message   String               @db.Text
  type      NotificationType
  priority  NotificationPriority @default(MEDIUM)
  metadata  Json?
  uniqueKey String?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id])
  store   Store?  @relation(fields: [storeId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([companyId, uniqueKey])
  @@map("notifications")
}



enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum PaymentMethodType {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
}

model Subscription {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String             @unique @db.Uuid
  packageId String?  @db.Uuid
  package   Package? @relation(fields: [packageId], references: [id])
  status    SubscriptionStatus @default(TRIALING)
  startDate DateTime           @default(now())
  endDate   DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  payments Payment[]

  @@map("subscription")
}

model Payment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String            @db.Uuid
  subscriptionId  String            @db.Uuid
  submittedById String? @db.Uuid
  amount          Float
  method          PaymentMethodType
  referenceNumber String
  status          PaymentStatus     @default(PENDING_VERIFICATION)
  
  verifiedById    String?           @db.Uuid
  verifiedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())

  
   company       Company        @relation(fields: [companyId], references: [id])
  subscription  Subscription   @relation(fields: [subscriptionId], references: [id])
  submittedBy User? @relation("PaymentSubmittedBy", fields: [submittedById], references: [id])
  verifiedBy    PlatformAdmin? @relation(fields: [verifiedById], references: [id])


  @@map("payment")
}

model PlatformAdmin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentsVerified Payment[]
  auditLogs PlatformAuditLog[]
  supportMessages SupportMessage[]

  @@map("platform_admin")
}

model Bundle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  featureKeys String[]
  price       Float
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packageBundles PackageBundle[]
  companyBundles CompanyBundle[]

  @@map("bundle")
}

model Package {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  price       Float
  maxStores   Int      @default(1)
  maxUsers    Int      @default(3)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bundles       PackageBundle[]
  subscriptions Subscription[]

  @@map("package")
}

model PackageBundle {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId String @db.Uuid
  bundleId  String @db.Uuid

  package Package @relation(fields: [packageId], references: [id])
  bundle  Bundle  @relation(fields: [bundleId], references: [id])

  @@unique([packageId, bundleId])
  @@map("package_bundle")
}

model BillingCycle {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  name        String
  payMonths   Int
  bonusMonths Int     @default(0)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  @@map("billing_cycle")
}

model CompanyBundle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  bundleId  String   @db.Uuid
  addedAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  bundle  Bundle  @relation(fields: [bundleId], references: [id])

  @@unique([companyId, bundleId])
  @@map("company_bundle")
}

model PlatformAuditLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformAdminId String   @db.Uuid
  action          String
  entityType      String
  entityId        String?
  metadata        Json?
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  @@map("platform_audit_log")
}

model SupportThread {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String              @db.Uuid
  subject       String
  status        SupportThreadStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lastMessageAt DateTime            @default(now())

  company  Company          @relation(fields: [companyId], references: [id])
  messages SupportMessage[]

  @@map("support_thread")
}

enum SupportThreadStatus {
  OPEN
  CLOSED
}

model SupportMessage {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId              String   @db.Uuid
  senderUserId          String?  @db.Uuid
  senderPlatformAdminId String?  @db.Uuid
  body                  String   @db.Text
  createdAt             DateTime @default(now())

  thread              SupportThread  @relation(fields: [threadId], references: [id])
  senderUser          User?          @relation(fields: [senderUserId], references: [id])
  senderPlatformAdmin PlatformAdmin? @relation(fields: [senderPlatformAdminId], references: [id])

  @@map("support_message")
}

model PurchaseOrder {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String              @db.Uuid
  storeId     String              @db.Uuid
  supplierId  String              @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)
  createdById String              @db.Uuid
  notes       String?
  createdAt   DateTime            @default(now())
  sentAt      DateTime?
  receivedAt  DateTime?

  items     PurchaseOrderItem[]
  company   Company  @relation(fields: [companyId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("purchase_order")
}

model PurchaseOrderItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId  String  @db.Uuid
  productId        String  @db.Uuid
  quantityOrdered  Float
  quantityReceived Float?
  unitCost         Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_item")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model CustomerPayment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String        @db.Uuid
  storeId     String        @db.Uuid
  customerId  String        @db.Uuid
  amount      Float
  method      PaymentMethod
  notes       String?
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("customer_payment")
}

model SalePayment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String        @db.Uuid
  method    PaymentMethod
  amount    Float
  reference String?
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("sale_payment")
}

enum ExpenseType {
  OPERATING
  CAPITAL
}