generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String?
  phone              String?
  country            String?
  currency           String              @default("UGX")
  timezone           String?
  logo               String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          AuditLog[]
  customers          Customer[]
  inventoryMovements InventoryMovement[]
  payrolls           Payroll[]
  products           Product[]
  sales              Sale[]
  stores             Store[]
  suppliers          Supplier[]
  users              User[]
  notifications      Notification[]

  expenses    Expense[]
  stockCounts StockCount[]

  @@map("company")
}

model Store {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String              @db.Uuid
  name               String
  location           String?
  phone              String?
  isHeadOffice       Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime?           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?           @default(now()) @updatedAt @db.Timestamptz(6)
  auditLogs          AuditLog[]
  customers          Customer[]
  outgoingTransfers  InventoryMovement[] @relation("TransferSource")
  inventoryMovements InventoryMovement[]
  incomingTransfers  InventoryMovement[] @relation("TransferTarget")
  payrolls           Payroll[]
  products           Product[]
  sales              Sale[]
  company            Company             @relation(fields: [companyId], references: [id])
  suppliers          Supplier[]
  activeUsers        User[]              @relation("ActiveStore")
  users              User[]
  notifications      Notification[]
  expenses           Expense[]
  stockCounts        StockCount[]

  @@map("store")
}

model User {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String              @db.Uuid
  name           String
  email          String
  passwordHash   String
  role           Role                @default(CASHIER)
  storeId        String              @db.Uuid
  activeStoreId  String?             @db.Uuid
  isActive       Boolean?            @default(true)
  createdAt      DateTime?           @default(now())
  updatedAt      DateTime?           @updatedAt
  auditLogs      AuditLog[]
  inventoryMoves InventoryMovement[]
  payrolls       Payroll[]
  sales          Sale[]
  notifications  Notification[]
  activeStore    Store?              @relation("ActiveStore", fields: [activeStoreId], references: [id])
  company        Company             @relation(fields: [companyId], references: [id])
  store          Store               @relation(fields: [storeId], references: [id])

  voidedSales     Sale[]    @relation("SaleVoidedBy")
  authorizedVoids Sale[]    @relation("SaleAuthorizedBy")
  expensesCreated Expense[] @relation("ExpenseCreatedBy")

  stockCountsCreated StockCount[] @relation("StockCountCreatedBy")

  @@unique([companyId, email])
  @@map("user")
}

model Product {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String              @db.Uuid
  storeId         String              @db.Uuid
  name            String
  barcode         String?
  sku             String
  buyingPrice     Float
  sellingPrice    Float
  stockQuantity   Float?              @default(0)
  unitType        String?             @default("pcs")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  isActive        Boolean             @default(true)
  inventoryMoves  InventoryMovement[]
  company         Company             @relation(fields: [companyId], references: [id])
  store           Store               @relation(fields: [storeId], references: [id])
  saleItems       SaleItem[]
  stockCountItems StockCountItem[]

  @@unique([companyId, sku])
  @@map("product")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @db.Uuid
  storeId     String   @db.Uuid
  name        String
  phone       String?
  email       String?
  totalCredit Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])

  @@map("customer")
}

model Sale {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @db.Uuid
  storeId         String        @db.Uuid
  userId          String        @db.Uuid
  totalAmount     Float
  subtotal        Float?
  vatAmount       Float?
  discount        Float         @default(0)
  paymentMethod   PaymentMethod
  status          SaleStatus    @default(COMPLETED)
  fiscalReceiptId String?
  qrCodeData      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  receiptNumber   String?
  invoiceNumber   String?
  requestedAt     DateTime?
  rejectionReason String?
  company         Company       @relation(fields: [companyId], references: [id])
  store           Store         @relation(fields: [storeId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  saleItems       SaleItem[]

  voidedAt       DateTime?
  voidReason     String?
  voidedById     String?   @db.Uuid
  authorizedById String?   @db.Uuid

  voidedBy     User? @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  authorizedBy User? @relation("SaleAuthorizedBy", fields: [authorizedById], references: [id])

  @@map("sale")
}

model SaleItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String    @db.Uuid
  productId String    @db.Uuid
  quantity  Float
  unitPrice Float
  subtotal  Float
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sale_item")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String                @db.Uuid
  storeId       String                @db.Uuid
  productId     String                @db.Uuid
  createdById   String                @db.Uuid
  type          InventoryMovementType
  quantity      Float
  reason        String?
  sourceStoreId String?               @db.Uuid
  targetStoreId String?               @db.Uuid
  createdAt     DateTime              @default(now())
  company       Company               @relation(fields: [companyId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  product       Product               @relation(fields: [productId], references: [id])
  sourceStore   Store?                @relation("TransferSource", fields: [sourceStoreId], references: [id])
  store         Store                 @relation(fields: [storeId], references: [id])
  targetStore   Store?                @relation("TransferTarget", fields: [targetStoreId], references: [id])

  @@map("inventory_movement")
}

model AuditLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  companyId  String    @db.Uuid
  storeId    String?   @db.Uuid
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  company    Company   @relation(fields: [companyId], references: [id])
  store      Store?    @relation(fields: [storeId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_log")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  storeId   String?  @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  totalOwed Float    @default(0)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  store     Store?   @relation(fields: [storeId], references: [id])

  @@map("supplier")
}

model Payroll {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String        @db.Uuid
  storeId    String        @db.Uuid
  userId     String        @db.Uuid
  month      String
  salary     Float
  bonus      Float         @default(0)
  deductions Float         @default(0)
  netPay     Float
  status     PayrollStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  company    Company       @relation(fields: [companyId], references: [id])
  store      Store         @relation(fields: [storeId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  @@map("payroll")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @db.Uuid
  storeId     String   @db.Uuid
  category    String
  description String?
  amount      Float
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])

  createdBy User @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@map("expense")
}

model StockCount {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String           @db.Uuid
  storeId     String           @db.Uuid
  createdById String           @db.Uuid
  status      StockCountStatus @default(OPEN)
  notes       String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  items       StockCountItem[]
  company     Company          @relation(fields: [companyId], references: [id])
  store       Store            @relation(fields: [storeId], references: [id])
  createdBy   User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])

  @@map("stock_count")
}

model StockCountItem {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockCountId    String     @db.Uuid
  productId       String     @db.Uuid
  systemQuantity  Float
  countedQuantity Float?
  variance        Float?
  stockCount      StockCount @relation(fields: [stockCountId], references: [id])
  product         Product    @relation(fields: [productId], references: [id])

  @@map("stock_count_item")
}

enum StockCountStatus {
  OPEN
  COMPLETED
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

enum Role {
  GENERAL_MANAGER
  BRANCH_MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  CREDIT
  MIXED
}

enum SaleStatus {
  COMPLETED
  PENDING_VOID
  PENDING_REFUND
  VOID
  REFUNDED
}

enum InventoryMovementType {
  IN
  OUT
  SALE
  ADJUSTMENT
}

enum NotificationType {
  LOW_STOCK
  LOGIN
  LOGOUT
  FAILED_LOGIN
  TARGET
  SALE
  INVENTORY
  SYSTEM
  APPROVAL_REQUEST
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Notification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String               @db.Uuid
  storeId   String?              @db.Uuid
  userId    String?              @db.Uuid
  title     String
  message   String               @db.Text
  type      NotificationType
  priority  NotificationPriority @default(MEDIUM)
  metadata  Json?
  uniqueKey String?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id])
  store   Store?  @relation(fields: [storeId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([companyId, uniqueKey])
  @@map("notifications")
}
